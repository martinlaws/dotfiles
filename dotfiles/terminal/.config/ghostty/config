# Ghostty configuration
#
# Stowed to ~/.config/ghostty/config by scripts/symlink-dotfiles.sh
# (the `terminal` stow package). Reference: https://ghostty.org/docs/config
#
# Ported from the previous Hyper setup: Night Owl theme, Fira Code's intended
# 12pt sizing (now on Ghostty's bundled JetBrains Mono), block cursor, and the
# same window padding.

# --- Appearance ---------------------------------------------------------------

# Night Owl — ships with Ghostty (the theme the old hyper-night-owl plugin gave).
theme = Night Owl

# Maple Mono v8 (2026-09-14; Monaspace Neon before that) — matches Zed.
# ⚠ Not bundled with Ghostty and not a Homebrew cask at v8 — it comes from
# scripts/install-maple-mono.sh. A fresh machine needs that first, or Ghostty
# silently falls back to a default font. Variable weight: try
# `font-variation = wght=450` to nudge it heavier.
font-family = "Maple Mono"
font-size = 12

# Hyper padding was "12px 14px" (top/bottom 12, left/right 14).
window-padding-x = 14
window-padding-y = 12

# --- Cursor -------------------------------------------------------------------

cursor-style = block
cursor-style-blink = false

# --- Shell --------------------------------------------------------------------

# Login shell picks up ~/.zshrc (Starship, fnm, atuin, etc.) like Hyper did.
macos-option-as-alt = true
