# Homebrew Bundle - GUI Applications
#
# Install all apps:
#   brew bundle install --file=config/Brewfile.apps
#
# For partial installation:
#   Use scripts/install-apps.sh which generates a filtered Brewfile
#   based on your selection (all/categories/individual)

###############################################################################
# Browsers
###############################################################################

cask "google-chrome"       # (essential) Primary browser
cask "arc"                 # (recommended) Daily driver browser
cask "comet"               # (recommended) Perplexity's agentic browser
cask "firefox"             # (optional) Alternative browser

# NOTE: the Perplexity *desktop app* has NO Homebrew cask — install it manually
# from perplexity.ai/download (it self-updates via its own launchd agent). Comet
# (above) is the agentic browser and IS available as a cask.

###############################################################################
# Dev Tools
###############################################################################

cask "visual-studio-code"          # (essential) Primary code editor
cask "visual-studio-code@insiders" # (recommended) VS Code Insiders — running as primary
# Cursor removed 2026-08-13 — leaving Anysphere on ownership grounds (SpaceX
# acquisition). Replaced by Zed below. See chaos
# technical/2026-08-10-editor-migration-research-v2.md.
cask "zed"                 # (recommended) Editor — Monaspace + vim mode + local models
cask "ghostty"             # (recommended) Terminal emulator (primary)
cask "hyper"               # (optional) Terminal emulator (fallback)
cask "claude"              # (recommended) Claude desktop app
cask "opencode-desktop"    # (optional) OpenCode AI coding agent desktop app
cask "docker-desktop"      # (optional) Docker Desktop — container platform
cask "postman"             # (optional) API testing
cask "ngrok"               # (recommended) Secure tunnels to localhost

###############################################################################
# Communication
###############################################################################

cask "slack"               # (essential) Team communication
cask "zoom"                # (recommended) Video conferencing
cask "discord"             # (optional) Community chat

###############################################################################
# Creative
###############################################################################

cask "figma"               # (recommended) Design tool (Stable)
cask "figma@beta"          # (recommended) Design tool (Beta)
cask "descript"            # (optional) Audio/video editing
cask "bambu-studio"        # (optional) 3D printing

###############################################################################
# Utilities
###############################################################################

cask "raycast"             # (recommended) Productivity launcher
cask "superwhisper"        # (recommended) Voice-to-text dictation
cask "aerospace"           # (optional) Tiling window manager (tap in Brewfile)

###############################################################################
# Fonts
###############################################################################

# ⚠ font-monaspace is load-bearing, not cosmetic: both ~/.config/ghostty/config
# and ~/.config/zed/settings.json name "Monaspace Neon" directly. Without this
# cask, both fall back to a default font silently rather than erroring.
#
# Verified 2026-08-13 against the .claude/rules/skill-design.md glyph palette
# (★ ◆ ✓ ✗ → • ▸ ⚠ … ↳ ━ ─ │): Monaspace Neon covers 13/13.
# ⚠ JetBrains Mono covers only 11/13 — it has NO ★ and NO ↳, both of which the
# palette uses heavily (`★ BEST PICK`, /avails adjacency footnotes). Those have
# been rendering via silent font fallback. So Monaspace is the better base for
# the skill-output design system, not merely the prettier one.
cask "font-monaspace"      # (essential) Monaspace — Ghostty + Zed, full glyph palette
cask "font-jetbrains-mono" # (optional) Previous font; ⚠ incomplete palette (11/13)

###############################################################################
# Security & Secrets
###############################################################################

cask "1password"           # (essential) Password manager — secrets source of truth
cask "1password-cli"       # (essential) op CLI — SSH agent + secret references

###############################################################################
# Productivity
###############################################################################

cask "notion"              # (recommended) Note-taking
cask "spotify"             # (recommended) Music streaming

###############################################################################
# Gaming
###############################################################################

cask "steam"               # (optional) Game platform
cask "battle-net"          # (optional) Blizzard games
